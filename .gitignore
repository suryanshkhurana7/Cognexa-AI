# ============================================================
# Root .gitignore — applies to the entire cognexa monorepo
# ============================================================

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment files (secrets — never commit)
.env
.env.*
!.env.example
!.env.sample

# Dependency directories
node_modules/

# Build outputs
dist/
dist-ssr/
build/

# Docker
*.override.yml

