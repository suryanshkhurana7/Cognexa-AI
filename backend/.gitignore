# ============================================================
# Backend .gitignore — Node.js / Express microservices
# ============================================================

# Dependencies
node_modules/

# Environment files
.env
.env.*
!.env.example
!.env.sample

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Firebase service account & credentials (NEVER commit these)
serviceAccountKey.json
*serviceAccount*.json
firebase-adminsdk*.json
google-credentials.json
credentials.json

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.sw?

# Build / temp
dist/
build/
tmp/
.tmp/

